{
	"trimTrailingSpaces": [
		{
			"line": "",
			"result": ""
		},
		{
			"line": "plain",
			"result": "plain"
		},
		{
			"line": "spaces   ",
			"result": "spaces"
		},
		{
			"line": "escaped\\ ",
			"result": "escaped\\ "
		},
		{
			"line": "escaped\\  ",
			"result": "escaped\\ "
		},
		{
			"line": "double\\\\ ",
			"result": "double\\\\"
		},
		{
			"line": "triple\\\\\\ ",
			"result": "triple\\\\\\ "
		},
		{
			"line": "tab\t",
			"result": "tab\t"
		},
		{
			"line": "crlf \r",
			"result": "crlf"
		},
		{
			"line": "   ",
			"result": ""
		}
	],
	"ruleSets": [
		{
			"name": "git documentation: hello.* and doc/frotz/",
			"text": "hello.*\ndoc/frotz/\nfrotz/\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 1,
					"pattern": "hello.*",
					"negated": false,
					"directoryOnly": false,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 2,
					"pattern": "doc/frotz/",
					"negated": false,
					"directoryOnly": true,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 3,
					"pattern": "frotz/",
					"negated": false,
					"directoryOnly": true,
					"anchored": false,
					"isValid": true
				}
			],
			"paths": [
				{
					"path": "hello.txt",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "hello.*",
						"negated": false,
						"path": "hello.txt"
					}
				},
				{
					"path": "src/hello.c",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "hello.*",
						"negated": false,
						"path": "src/hello.c"
					}
				},
				{
					"path": "hello",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "doc/frotz",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "frotz/",
						"negated": false,
						"path": "doc/frotz"
					}
				},
				{
					"path": "doc/frotz",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "a/doc/frotz",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "frotz/",
						"negated": false,
						"path": "a/doc/frotz"
					}
				},
				{
					"path": "frotz",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "frotz/",
						"negated": false,
						"path": "frotz"
					}
				},
				{
					"path": "a/frotz",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "frotz/",
						"negated": false,
						"path": "a/frotz"
					}
				},
				{
					"path": "a/frotz/file",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "frotz/",
						"negated": false,
						"path": "a/frotz"
					}
				}
			]
		},
		{
			"name": "git documentation: foo/* matches only direct children",
			"text": "foo/*\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 1,
					"pattern": "foo/*",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				}
			],
			"paths": [
				{
					"path": "foo/test.json",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "foo/*",
						"negated": false,
						"path": "foo/test.json"
					}
				},
				{
					"path": "foo/bar",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "foo/*",
						"negated": false,
						"path": "foo/bar"
					}
				},
				{
					"path": "foo/bar/hello.c",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "foo/*",
						"negated": false,
						"path": "foo/bar"
					}
				},
				{
					"path": "a/foo/test.json",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "foo",
					"isDirectory": true,
					"isIgnored": false,
					"match": null
				}
			]
		},
		{
			"name": "git documentation: exclude everything except foo/bar",
			"text": "# exclude everything except directory foo/bar\n/*\n!/foo\n/foo/*\n!/foo/bar\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 2,
					"pattern": "/*",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 3,
					"pattern": "!/foo",
					"negated": true,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 4,
					"pattern": "/foo/*",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 5,
					"pattern": "!/foo/bar",
					"negated": true,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				}
			],
			"paths": [
				{
					"path": "README.md",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "/*",
						"negated": false,
						"path": "README.md"
					}
				},
				{
					"path": "src",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "/*",
						"negated": false,
						"path": "src"
					}
				},
				{
					"path": "src/main.c",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "/*",
						"negated": false,
						"path": "src"
					}
				},
				{
					"path": "foo",
					"isDirectory": true,
					"isIgnored": false,
					"match": {
						"line": 3,
						"pattern": "!/foo",
						"negated": true,
						"path": "foo"
					}
				},
				{
					"path": "foo/baz",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "/foo/*",
						"negated": false,
						"path": "foo/baz"
					}
				},
				{
					"path": "foo/qux",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "/foo/*",
						"negated": false,
						"path": "foo/qux"
					}
				},
				{
					"path": "foo/qux/file",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "/foo/*",
						"negated": false,
						"path": "foo/qux"
					}
				},
				{
					"path": "foo/bar",
					"isDirectory": true,
					"isIgnored": false,
					"match": {
						"line": 5,
						"pattern": "!/foo/bar",
						"negated": true,
						"path": "foo/bar"
					}
				},
				{
					"path": "foo/bar/file",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				}
			]
		},
		{
			"name": "git documentation: objects, archives and Documentation/*.html",
			"text": "# ignore objects and archives, anywhere in the tree.\n*.[oa]\n\nDocumentation/*.html\n!Documentation/foo.html\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 2,
					"pattern": "*.[oa]",
					"negated": false,
					"directoryOnly": false,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 4,
					"pattern": "Documentation/*.html",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 5,
					"pattern": "!Documentation/foo.html",
					"negated": true,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				}
			],
			"paths": [
				{
					"path": "main.o",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "*.[oa]",
						"negated": false,
						"path": "main.o"
					}
				},
				{
					"path": "lib/libz.a",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "*.[oa]",
						"negated": false,
						"path": "lib/libz.a"
					}
				},
				{
					"path": "main.c",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "Documentation/git.html",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "Documentation/*.html",
						"negated": false,
						"path": "Documentation/git.html"
					}
				},
				{
					"path": "Documentation/foo.html",
					"isDirectory": false,
					"isIgnored": false,
					"match": {
						"line": 5,
						"pattern": "!Documentation/foo.html",
						"negated": true,
						"path": "Documentation/foo.html"
					}
				},
				{
					"path": "Documentation/ppc/ppc.html",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "tools/Documentation/git.html",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				}
			]
		},
		{
			"name": "double asterisks",
			"text": "**/logs\n**/cache/tmp\nabc/**\na/**/b\nx**y\n/**/deep.txt\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 1,
					"pattern": "**/logs",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 2,
					"pattern": "**/cache/tmp",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 3,
					"pattern": "abc/**",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 4,
					"pattern": "a/**/b",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 5,
					"pattern": "x**y",
					"negated": false,
					"directoryOnly": false,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 6,
					"pattern": "/**/deep.txt",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				}
			],
			"paths": [
				{
					"path": "logs",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "**/logs",
						"negated": false,
						"path": "logs"
					}
				},
				{
					"path": "src/logs",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "**/logs",
						"negated": false,
						"path": "src/logs"
					}
				},
				{
					"path": "src/logs/today.log",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "**/logs",
						"negated": false,
						"path": "src/logs"
					}
				},
				{
					"path": "cache/tmp",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "**/cache/tmp",
						"negated": false,
						"path": "cache/tmp"
					}
				},
				{
					"path": "src/cache/tmp",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "**/cache/tmp",
						"negated": false,
						"path": "src/cache/tmp"
					}
				},
				{
					"path": "abc",
					"isDirectory": true,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "abc/file",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "abc/**",
						"negated": false,
						"path": "abc/file"
					}
				},
				{
					"path": "abc/sub/file",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "abc/**",
						"negated": false,
						"path": "abc/sub"
					}
				},
				{
					"path": "a/b",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "a/**/b",
						"negated": false,
						"path": "a/b"
					}
				},
				{
					"path": "a/x/b",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "a/**/b",
						"negated": false,
						"path": "a/x/b"
					}
				},
				{
					"path": "a/x/y/b",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "a/**/b",
						"negated": false,
						"path": "a/x/y/b"
					}
				},
				{
					"path": "z/a/b",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "xay",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 5,
						"pattern": "x**y",
						"negated": false,
						"path": "xay"
					}
				},
				{
					"path": "xa/by",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "deep.txt",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 6,
						"pattern": "/**/deep.txt",
						"negated": false,
						"path": "deep.txt"
					}
				},
				{
					"path": "one/two/deep.txt",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 6,
						"pattern": "/**/deep.txt",
						"negated": false,
						"path": "one/two/deep.txt"
					}
				}
			]
		},
		{
			"name": "anchoring and directory-only rules",
			"text": "/build\nout/\nsrc/gen\n/dist/\nnode_modules\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 1,
					"pattern": "/build",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 2,
					"pattern": "out/",
					"negated": false,
					"directoryOnly": true,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 3,
					"pattern": "src/gen",
					"negated": false,
					"directoryOnly": false,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 4,
					"pattern": "/dist/",
					"negated": false,
					"directoryOnly": true,
					"anchored": true,
					"isValid": true
				},
				{
					"line": 5,
					"pattern": "node_modules",
					"negated": false,
					"directoryOnly": false,
					"anchored": false,
					"isValid": true
				}
			],
			"paths": [
				{
					"path": "build",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "/build",
						"negated": false,
						"path": "build"
					}
				},
				{
					"path": "build",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 1,
						"pattern": "/build",
						"negated": false,
						"path": "build"
					}
				},
				{
					"path": "app/build",
					"isDirectory": true,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "out",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "out/",
						"negated": false,
						"path": "out"
					}
				},
				{
					"path": "out",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "app/out",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "out/",
						"negated": false,
						"path": "app/out"
					}
				},
				{
					"path": "app/out/a.js",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 2,
						"pattern": "out/",
						"negated": false,
						"path": "app/out"
					}
				},
				{
					"path": "src/gen",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 3,
						"pattern": "src/gen",
						"negated": false,
						"path": "src/gen"
					}
				},
				{
					"path": "app/src/gen",
					"isDirectory": true,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "dist",
					"isDirectory": true,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "/dist/",
						"negated": false,
						"path": "dist"
					}
				},
				{
					"path": "dist",
					"isDirectory": false,
					"isIgnored": false,
					"match": null
				},
				{
					"path": "dist/",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "/dist/",
						"negated": false,
						"path": "dist"
					}
				},
				{
					"path": "./dist/app.js",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 4,
						"pattern": "/dist/",
						"negated": false,
						"path": "dist"
					}
				},
				{
					"path": "node_modules",
					"isDirectory": true,
