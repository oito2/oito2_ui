						"line": 5,
						"pattern": "node_modules",
						"negated": false,
						"path": "node_modules"
					}
				},
				{
					"path": "a/b/node_modules/x/index.js",
					"isDirectory": false,
					"isIgnored": true,
					"match": {
						"line": 5,
						"pattern": "node_modules",
						"negated": false,
						"path": "a/b/node_modules"
					}
				}
			]
		},
		{
			"name": "negation",
			"text": "*.log\n!important.log\nlogs/\n!logs/keep.log\ntmp/*\n!tmp/.gitkeep\n",
			"ignoreCase": false,
			"rules": [
				{
					"line": 1,
					"pattern": "*.log",
					"negated": false,
					"directoryOnly": false,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 2,
					"pattern": "!important.log",
					"negated": true,
					"directoryOnly": false,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 3,
					"pattern": "logs/",
					"negated": false,
					"directoryOnly": true,
					"anchored": false,
					"isValid": true
				},
				{
					"line": 4,
